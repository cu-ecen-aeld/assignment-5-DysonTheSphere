#!/bin/sh

MOD_DIR="/lib/modules/$(uname -r)/updates"

case "$1" in
    start)
        echo "Loading LDD modules..."
        cd "$MOD_DIR"
        scull_load
        module_load faulty
        modprobe hello
        ;;
    stop)
        echo "Unloading LDD modules..."
        cd "$MOD_DIR"
        rmmod hello
        module_unload faulty
        scull_unload
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
esac

exit 0
